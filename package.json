{
  "name": "c-stack-viz",
  "displayName": "C Stack Visualizer",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:c"
  ],
  "contributes": {
    "commands": [
      {
        "command": "c-stack-viz.start",
        "title": "Start C Visualizer"
      },
      {
        "command": "c-stack-viz.stop",
        "title": "Stop C Visualizer"
      },
      {
        "command": "c-stack-viz.stepForward",
        "title": "Step Forward"
      },
      {
        "command": "c-stack-viz.stepBack",
        "title": "Step Back"
      }
    ],
    "keybindings": [
      {
        "command": "c-stack-viz.stepForward",
        "key": "alt+right",
        "mac": "alt+right",
        "when": "c-stack-viz.active && editorTextFocus"
      },
      {
        "command": "c-stack-viz.stepBack",
        "key": "alt+left",
        "mac": "alt+left",
        "when": "c-stack-viz.active && editorTextFocus"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build-webview": "cd webview && npm run build",
    "dev:host": "npm run compile && code --extensionDevelopmentPath=. --disable-extensions --user-data-dir=%TEMP%\\c-stack-viz-devhost --new-window"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.0.0"
  }
}
